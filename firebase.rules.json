{
  "rules": {
    ".read": false,
    ".write": false,

    "roles": {
      ".read": "auth != null && root.child('roles').child(auth.uid).child('role').val() === 'owner'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('roles').child(auth.uid).child('role').val() === 'owner' || (!data.exists() && auth.uid === $uid && newData.child('role').val() === 'pending'))",
        "lastSeenAt": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "liveRates": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).child('role').val() === 'owner' || root.child('roles').child(auth.uid).child('role').val() === 'editor' || root.child('roles').child(auth.uid).child('role').val() === 'viewer' || root.child('roles').child(auth.uid).child('role').val() === 'service')",
      ".write": "auth != null && (root.child('roles').child(auth.uid).child('role').val() === 'owner' || root.child('roles').child(auth.uid).child('role').val() === 'editor' || root.child('roles').child(auth.uid).child('role').val() === 'service')"
    },

    "holdings": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).child('role').val() === 'owner' || root.child('roles').child(auth.uid).child('role').val() === 'editor' || root.child('roles').child(auth.uid).child('role').val() === 'viewer' || root.child('roles').child(auth.uid).child('role').val() === 'service')",
      ".write": "auth != null && (root.child('roles').child(auth.uid).child('role').val() === 'owner' || root.child('roles').child(auth.uid).child('role').val() === 'editor')"
    },
    "loans": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).child('role').val() === 'owner' || root.child('roles').child(auth.uid).child('role').val() === 'editor' || root.child('roles').child(auth.uid).child('role').val() === 'viewer' || root.child('roles').child(auth.uid).child('role').val() === 'service')",
      ".write": "auth != null && (root.child('roles').child(auth.uid).child('role').val() === 'owner' || root.child('roles').child(auth.uid).child('role').val() === 'editor')"
    },
    "conversions": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).child('role').val() === 'owner' || root.child('roles').child(auth.uid).child('role').val() === 'editor' || root.child('roles').child(auth.uid).child('role').val() === 'viewer')",
      ".write": "auth != null && (root.child('roles').child(auth.uid).child('role').val() === 'owner' || root.child('roles').child(auth.uid).child('role').val() === 'editor')"
    },
    "daily": {
      ".read": "auth != null && (root.child('roles').child(auth.uid).child('role').val() === 'owner' || root.child('roles').child(auth.uid).child('role').val() === 'editor' || root.child('roles').child(auth.uid).child('role').val() === 'viewer' || root.child('roles').child(auth.uid).child('role').val() === 'service')",
      ".write": "auth != null && (root.child('roles').child(auth.uid).child('role').val() === 'owner' || root.child('roles').child(auth.uid).child('role').val() === 'editor')"
    }
  }
}
